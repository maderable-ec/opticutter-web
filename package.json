{
  "name": "maderable-dashboard",
  "version": "5.6.0",
  "description": "Maderable Dashboard",
  "homepage": ".",
  "license": "MIT",
  "author": "Denis Siavichay",
  "scripts": {
    "build": "vite build",
    "lint": "eslint src e2e playwright.config.ts",
    "lint:fix": "eslint src e2e playwright.config.ts --fix",
    "format": "prettier --write src e2e playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "validate": "tsc --noEmit && tsc --noEmit -p e2e && eslint src e2e playwright.config.ts",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop --project=taller-infinix --project=taller-ipad",
    "test:e2e:ui": "playwright test --ui",
    "screens": "playwright test --project=screens"
  },
  "dependencies": {
    "@coreui/chartjs": "^4.2.0",
    "@coreui/coreui": "^5.6.1",
    "@coreui/icons": "^3.0.1",
    "@coreui/icons-react": "^2.3.0",
    "@coreui/react": "^5.10.0",
    "@coreui/react-chartjs": "^3.0.0",
    "@coreui/utils": "^2.0.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "chart.js": "^4.5.1",
    "core-js": "^3.49.0",
    "posthog-js": "^1.434.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "simplebar-react": "^3.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "prettier": "3.8.1",
    "sass": "^1.98.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.3",
    "vitest": "^5.0.2"
  }
}
